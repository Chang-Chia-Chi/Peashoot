#!/bin/sh
# Kotlin-native pre-commit: format staged Kotlin files, re-stage them, then run the build's checks.
# Activate once per clone:  git config core.hooksPath .githooks
set -e
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.kt')
for f in $files; do
  module=${f%%/*}
  case "$module" in
    core|proxy|app)
      inside=${f#*/}
      case "$inside" in src/test/*) task=ktfmtFormatTest ;; *) task=ktfmtFormatMain ;; esac
      ./gradlew -q ":$module:$task" "--include-only=$inside" ;;
  esac
done
[ -n "$files" ] && git add $files
# The farm's GDScript, when any is staged: formatted, re-staged and linted (farm/requirements-lint.txt).
scripts=$(git diff --cached --name-only --diff-filter=ACMR -- 'farm/*.gd' | grep -v '^farm/studies/' || true)
if [ -n "$scripts" ]; then
  command -v gdformat >/dev/null || { echo "pip install -r farm/requirements-lint.txt"; exit 1; }
  gdformat $scripts
  git add $scripts
  gdlint $scripts
fi
./gradlew -q check
